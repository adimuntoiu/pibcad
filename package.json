{
	"name": "pibcad",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": [
			"./src/lib/*",
			"./src/lib/*.ts",
			"./src/lib/*.svelte.ts"
		]
	},
	"scripts": {
		"dev": "concurrently -k -n BACKEND,FRONTEND -c cyan,green \"node scripts/run-backend.js\" \"vite dev\"",
		"dev:frontend": "vite dev",
		"dev:backend": "node scripts/run-backend.js",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"compile:targets": "node scripts/compile-targets.js",
		"generate:glbs": "backend/.venv/bin/python scripts/generate-demo-glbs.py",
		"convert:obj": "backend/.venv/bin/python scripts/convert-obj-to-glb.py"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"concurrently": "^10.0.7",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource/jockey-one": "^5.3.0",
		"@fontsource/josefin-sans": "^5.3.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"@types/three": "^0.187.0",
		"three": "^0.187.0"
	}
}
